{
  "name": "nuclear-biology-reviews",
  "version": "1.0.0",
  "description": "CellNucleus education by Gnometrix Labs: 62 indexed research pages, 17 hypothesis reviews, and 6 reading-level variants",
  "main": "index.html",
  "scripts": {
    "start": "python scripts/preview_candidate.py --root . --port 8000",
    "serve": "python scripts/preview_candidate.py --root . --port 8000",
    "build": "python scripts/validate_candidate.py --strict --check-js --output reports/build-validation.json",
    "test": "python scripts/validate_candidate.py --strict --check-js --output reports/technical-validation.json",
    "validate": "python scripts/validate_candidate.py --strict --check-js --output reports/technical-validation.json",
    "deploy-gh-pages": "gh-pages -d .",
    "deploy-netlify": "netlify deploy --dir=. --prod",
    "lint-html": "htmlhint '*.html' 'nuclear_biology_reviews/reviews/*.html' 'hypothesis_reviews/*.html'",
    "lint-css": "stylelint 'assets/css/*.css'",
    "lint-js": "eslint 'assets/js/*.js'",
    "optimize-images": "imageoptim assets/images/",
    "check-links": "broken-link-checker http://localhost:8000",
    "lighthouse": "lighthouse http://localhost:8000 --output=json --output-path=./lighthouse-report.json"
  },
  "keywords": [
    "nuclear-biology",
    "cell-biology",
    "molecular-biology",
    "research",
    "reviews",
    "academic",
    "education",
    "science",
    "biology",
    "cellular-structures"
  ],
  "author": "Gnometrix Labs",
  "license": "MIT",
  "homepage": "https://cellnucleus.com/",
  "devDependencies": {
    "html5validator": "^0.4.2",
    "htmlhint": "^1.1.4",
    "stylelint": "^15.10.3",
    "stylelint-config-standard": "^34.0.0",
    "eslint": "^8.48.0",
    "broken-link-checker": "^0.7.8",
    "lighthouse": "^10.4.0",
    "gh-pages": "^6.0.0",
    "netlify-cli": "^17.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}
